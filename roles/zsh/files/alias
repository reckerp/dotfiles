alias nv="nvim"

alias ga="git add ."
alias gca="git commit --amend --no-edit --date=now"
alias gcam="git commit --amend --date=now"
alias gs="git status"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash pop"
alias glg="git log --graph --oneline"

alias ls="eza -l --header --icons --git"

